# swaylock config
# Palette: Catppuccin Mocha (matches rofi and mako)

font=Noto Sans Mono
font-size=24

# Same wallpaper swaybg uses on the desktop; both link libglycin for
# jxl decoding so this renders fine. color= is the fallback for any
# output the image doesn't cover.
image=/home/khanh/Pictures/wallpapers/F42-01-night.jpg
scaling=fill
color=1e1e2e

# Show failed attempt count, current xkb layout, caps lock state
show-failed-attempts
show-keyboard-layout
indicator-caps-lock

# Keep the indicator on screen even before you start typing
indicator-idle-visible
indicator-radius=100
indicator-thickness=10

# Ring (idle)
ring-color=45475a
inside-color=1e1e2e
text-color=cdd6f4

# Ring while verifying password
ring-ver-color=89b4fa
inside-ver-color=1e1e2e
text-ver-color=cdd6f4

# Ring on wrong password
ring-wrong-color=f38ba8
inside-wrong-color=1e1e2e
text-wrong-color=f38ba8

# Ring while typing (cleared state between keystrokes)
ring-clear-color=f9e2af
inside-clear-color=1e1e2e
text-clear-color=f9e2af

# Ring when Caps Lock is active
ring-caps-lock-color=fab387
inside-caps-lock-color=1e1e2e
text-caps-lock-color=fab387

line-uses-ring

# Key press highlight segments
key-hl-color=a6e3a1
bs-hl-color=f38ba8
separator-color=585b70

# Keyboard layout label box
layout-bg-color=45475a
layout-border-color=585b70
layout-text-color=cdd6f4
