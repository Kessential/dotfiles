# swaylock config
# Palette: Tokyo Night (night) (matches rofi and mako)

font=Noto Sans Mono
font-size=24

# Same wallpaper swaybg uses on the desktop; both link libglycin for
# jxl decoding so this renders fine. color= is the fallback for any
# output the image doesn't cover.
image=/usr/share/backgrounds/default-dark.jxl
scaling=fill
color=1a1b26

# Show failed attempt count, current xkb layout, caps lock state
show-failed-attempts
show-keyboard-layout
indicator-caps-lock

# Keep the indicator on screen even before you start typing
indicator-idle-visible
indicator-radius=100
indicator-thickness=10

# Ring (idle)
ring-color=3b4261
inside-color=1a1b26
text-color=c0caf5

# Ring while verifying password
ring-ver-color=7aa2f7
inside-ver-color=1a1b26
text-ver-color=c0caf5

# Ring on wrong password
ring-wrong-color=f7768e
inside-wrong-color=1a1b26
text-wrong-color=f7768e

# Ring while typing (cleared state between keystrokes)
ring-clear-color=e0af68
inside-clear-color=1a1b26
text-clear-color=e0af68

# Ring when Caps Lock is active
ring-caps-lock-color=ff9e64
inside-caps-lock-color=1a1b26
text-caps-lock-color=ff9e64

line-uses-ring

# Key press highlight segments
key-hl-color=9ece6a
bs-hl-color=f7768e
separator-color=414868

# Keyboard layout label box
layout-bg-color=3b4261
layout-border-color=414868
layout-text-color=c0caf5
