# mako config
# Palette: Tokyo Night (night), matching rofi and swaylock.

font=Noto Sans Mono 11
sort=-time
max-history=100
default-timeout=6000
group-by=app-name
max-visible=5
layer=overlay
anchor=top-right

width=350
height=110
padding=12
margin=10
border-size=2
border-radius=10

background-color=#1a1b26F2
text-color=#c0caf5FF
border-color=#bb9af7FF
progress-color=over #3b4261FF

icons=1
max-icon-size=48
icon-location=left

[urgency=low]
border-color=#3b4261FF
default-timeout=4000

[urgency=critical]
border-color=#f7768eFF
default-timeout=0

[mode=do-not-disturb]
invisible=1
